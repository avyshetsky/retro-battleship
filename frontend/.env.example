# Base URL of the Battleship backend API (AI moves + taunts).
# Leave empty to run the game fully client-side ("LOCAL AI MODE").
# Example for local dev against the backend:
#   VITE_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=

# Optional Supabase project for a GLOBAL, persistent leaderboard.
# When both are set, high scores are shared across every player and survive
# across sessions; otherwise the game falls back to this browser's localStorage.
#   VITE_SUPABASE_URL=https://your-project.supabase.co
#   VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
